/dts-v1/;

#include <st/h7/stm32h723Xg.dtsi>
#include <st/h7/stm32h723vgtx-pinctrl.dtsi>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	model = "H7_Work";
	compatible = "candlelightfd";

	aliases {
		rtt-custom-section = &rtt_region;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,canbus2 = &fdcan1;
		zephyr,canbus3 = &fdcan3;
	};

	cannectivity: cannectivity {
		compatible = "cannectivity";
		timestamp-counter = <&counters2>;

		channel1 {
			compatible = "cannectivity-channel";
			can-controller = <&fdcan1>;
		};

		channel3 {
			compatible = "cannectivity-channel";
			can-controller = <&fdcan3>;
		};
	};

	gs_usb0: gs_usb0 {
		compatible = "gs_usb";
		label = "gs_usb";
	};

	can_loopback0: can_loopback {
		compatible = "zephyr,can-loopback";
		status = "okay";
	};

	rtt_region: memory@2404e000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2404e000 DT_SIZE_K(8)>;
		zephyr,memory-region = "RTT_NOCACHE";
		zephyr,memory-attr = <DT_MEM_ARM_MPU_RAM_NOCACHE>;
	};

	usb_phy0: usb-phy-ulpi {
		compatible = "usb-ulpi-phy";
		#phy-cells = <0>;
	};
};

&sram0 {
	reg = <0x24000000 DT_SIZE_K(312)>;
};

/* Adjust the pll for a SYSTEM Clock of 480 MHz  */
&clk_hse {
	hse-bypass;
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	clocks = <&clk_hse>;
	div-m = <4>;   // 2 MHz to PLL（VCO）
	mul-n = <260>; // 520MHz
	div-p = <1>;   // 520MHz to SYS
	div-q = <13>;   // 20 MHz
	div-r = <13>;   // 20MHz to UART234578
	fracn = <0>;
	status = "okay";
};

&pll2 {
	clocks = <&clk_hse>;
	div-m = <1>;  // 8   MHz to PLL2（VCO）
	mul-n = <25>; // 200 MHz
	div-p = <2>;  // 100 MHz
	div-q = <2>;  // 100 MHz to FDCAN
	div-r = <2>;  // 100 MHz
	fracn = <0>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(520)>;     /* 520 MHz SCLK*/
	d1cpre = <1>;                           /* 520 MHz CPU Clocks*/
	hpre = <4>;				/* 130 MHz */
	d1ppre = <1>;				/* 130 MHz APB3 Peripheral Clock */
	d2ppre1 = <1>;				/* 130 MHz APB1 Peripheral Clock */
	d2ppre2 = <1>;				/* 130 MHz APB2 Peripheral Clock */
	d3ppre = <1>;				/* 130 MHz APB4 Peripheral Clock */
	timpre;					/* Timer Clock Prescaler */
};

&clk_hsi48 {
	status = "okay";
};

zephyr_udc0: &usbotg_hs {
	pinctrl-0 = <&usb_otg_hs_ulpi_d0_pa3
		     &usb_otg_hs_ulpi_d1_pb0
		     &usb_otg_hs_ulpi_d2_pb1
		     &usb_otg_hs_ulpi_d3_pb10
		     &usb_otg_hs_ulpi_d4_pb11
		     &usb_otg_hs_ulpi_d5_pb12
		     &usb_otg_hs_ulpi_d6_pb13
		     &usb_otg_hs_ulpi_d7_pb5
		     &usb_otg_hs_ulpi_ck_pa5
		     &usb_otg_hs_ulpi_stp_pc0
		     &usb_otg_hs_ulpi_dir_pc2_c
		     &usb_otg_hs_ulpi_nxt_pc3_c>;
	pinctrl-names = "default";
	interrupts = <74 0>, <75 0>, <76 0>, <77 0>;
	num-bidir-endpoints = <9>;
	phys = <&usb_phy0>;
	maximum-speed = "high-speed";
	ram-size = <DT_SIZE_K(4)>;
	clocks = <&rcc STM32_CLOCK_BUS_AHB1 0x06000000>,
		 <&rcc STM32_SRC_HSI48 USB_SEL(3)>;
	status = "okay";
};

&fdcan1 {
	/* 本板(ULPI 高速板)原理图: FDCAN1_TX -> U2-71(PA12) -> U3(TXD)
	 *                        FDCAN1_RX -> U2-70(PA11) -> U3(RXD)
	 * PD0/PD1 在板上是悬空的，配成 PD0/PD1 会导致报文根本到不了收发器，
	 * 控制器收不到 ACK -> bus-off -> can_send 返回 -ENETUNREACH(-114)
	 */
	pinctrl-0 = <&fdcan1_rx_pa11 &fdcan1_tx_pa12>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
	status = "okay";
};

&fdcan3 {
	pinctrl-0 = <&fdcan3_rx_pd12 &fdcan3_tx_pd13>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
	status = "okay";
};

&timers2 {
	status = "okay";
	st,prescaler = <239>;

	counters2: counter {
		status = "okay";
	};
};

&pwr {
	power-supply = "ldo";
};
