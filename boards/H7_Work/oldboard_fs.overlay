/*
 * 旧板（H7_Work 原始板）A/B 验证用 overlay
 *
 * 用法：
 *   west build -p always -b H7_Work ~/Zephyr_text/H7_Work -- \
 *       -DDTC_OVERLAY_FILE=boards/H7_Work/oldboard_fs.overlay
 *
 * 作用：把 USB 从"外部 ULPI PHY"切回"MCU 内置 FS PHY（PA11/PA12）"。
 * 注意：新测试板（ULPI）不要用这个 overlay。
 *      旧板上 CAN 引脚(PB12/PB13)与当前 dts(fdcan1/fdcan3) 不匹配，
 *      只验 USB 时可以忽略 CAN 报错。
 */

&usbotg_hs {
	pinctrl-0 = <&usb_otg_hs_dm_pa11 &usb_otg_hs_dp_pa12>;
	pinctrl-names = "default";
	phys = <&otghs_fs_phy>;
	maximum-speed = "full-speed";
};
