        "./zephyr/dts",
        "./zephyr/dts/common",
        "./zephyr/dts/arm",          // 解析 <st/h7/stm32h723Xg.dtsi>
        "./zephyr/dts/arm64",
        "./zephyr/dts/riscv",
        "./zephyr/dts/vendor",
        "./zephyr/dts/xtensa",
        "./zephyr/include",          // 解析 <zephyr/dt-bindings/...>
        "./modules/hal/stm32/dts"    // 解析 <st/h7/*-pinctrl.dtsi>
    ],
    "devicetree.defaultZephyrBindings": [
        "./zephyr/dts/bindings",
        "./custom/cannectivity/dts/bindings"
