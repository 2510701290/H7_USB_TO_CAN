# ---------- Zephyr / west 构建产物（最关键的一条）----------
# 覆盖 build/、build-h7/、build-debug/ 等任意层级，缺了它整个构建目录都会被提交
**/build*/
twister-out*/
*.elf
*.bin
*.hex
*.map

# ---------- west 工作区相关 ----------
docs/原理图/
docs/芯片文档/

# ---------- 外部资料 ----------
.venv/
external

# ---------- 编辑器/IDE 本机配置 ----------
.vscode/compile_commands.json
.vscode/extensions.json
.vscode/zephyr-ide.json

Z_SEGGER/H7_Work_Ozone.jdebug.user

# ---------- 其它生成物 ----------
.cache/
__pycache__/
*.py[cod]
# 大体积测试日志不进仓库
docs/CAN_ANALYSIS/CS_*.txt
# AI 调试草稿不进仓库
.dsh_cs

# ---------- 临时备份 ----------
# 改动前的原文件备份（如 Basic_USB.cpp.bak），只是本地回滚用，不进仓库
.tmp/
