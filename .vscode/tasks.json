{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "west build (H7_Work)",
      "type": "shell",
      "command": "west build -p always -b H7_Work",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "/home/rm/zephyrproject/.venv/bin:${env:PATH}",
          "ZEPHYR_BASE": "/home/rm/zephyrproject/zephyr",
          "ZEPHYR_SDK_INSTALL_DIR": "/home/rm/zephyr-sdk-1.0.1"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "west flash + rtt",
      "type": "shell",
      // west flash + uid(pyocd list可以查到id)
      // "command": "west flash --runner pyocd --dev-id <uid>",

      // pyocd + USB_RESET.py + west rtt
      // "command": "west flash --runner pyocd && python3 ${workspaceFolder}/userpy/USB_RESET.py && west rtt --runner pyocd",

      // Jlink
      // "command": "west flash && python3 ${workspaceFolder}/userpy/USB_RESET.py && west rtt --tool-opt=\"-jlinkscriptfile ${workspaceFolder}/Z_SEGGER/rtt_range.JLinkScript\"",
      "command": "west flash -d ${workspaceFolder}/build --runner jlink",

      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "west-rtt",
        "pattern": { "regexp": "^$" },
        "background": { "activeOnStart": true, "beginsPattern": "a^", "endsPattern": "a^" }
      },
      "group": { "kind": "none"},
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "open ozone",
      "type": "shell",
      "command": "ozone -project ${workspaceFolder}/Z_SEGGER/H7_Work_Ozone.jdebug",
      
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "jlink vofa",
        "pattern": { "regexp": "^$" },
        "background": { "activeOnStart": true, "beginsPattern": "a^", "endsPattern": "a^" }
      },
      "group": { "kind": "none"},
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
